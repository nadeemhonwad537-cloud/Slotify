{
  "name": "slotify-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "migrate": "tsx src/db/migrate.ts",
    "seed:reference": "tsx src/db/migrate.ts --seed",
    "db:reset": "tsx src/db/reset.ts",
    "create-admin": "tsx src/scripts/createAdmin.ts",
    "preview:workload-import": "tsx src/scripts/previewWorkloadImport.ts",
    "plan:workload-import": "tsx src/scripts/planWorkloadImport.ts",
    "import:workload-source": "tsx src/scripts/importWorkloadSource.ts",
    "verify:workload-import": "tsx src/scripts/verifyWorkloadImport.ts",
    "test:workload-preview": "tsx --test tests/workloadImportPreview.node.test.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mysql2": "^3.11.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^22.5.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
